{
  "name": "@vijimlabs/ui",
  "version": "0.2.19",
  "private": true,
  "description": "VIJIM Labs 唯一业务 UI 出口。应用只 import 本包；Mantine 9 仅为包内实现，禁止业务直连。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@mantine/charts": "^9.5.0",
    "@mantine/core": "^9.5.0",
    "@mantine/dates": "^9.5.0",
    "@mantine/dropzone": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@mantine/spotlight": "^9.5.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8",
    "typescript": "^5"
  }
}
